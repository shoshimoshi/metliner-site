---
import Icons from '../components/Icons.astro';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../config/theme.css';
import cityNames from '../data/city-names.json';
import allCities from '../data/cities.json';

const { continent, contKey, country, countryKey, lang = 'en' } = Astro.props;
const ui = {
  en: { maps:'Maps', metraveler:'Metraveler', about:'About us', contact:'Contact us', langLabel:'English', back:'Back to' },
  zh: { maps:'地圖', metraveler:'Metraveler', about:'關於我們', contact:'聯絡我們', langLabel:'繁體中文', back:'返回' }
}[lang];
const base = lang === 'en' ? '/english' : '/zh';
const color = continent.color;

const cities = country.cities.map(slug => ({
  slug,
  name: (cityNames[slug]||{})[lang] || slug,
  nameEn: (cityNames[slug]||{}).en || slug,
  // map thumbnail (the Unsplash keyword-photo service this used was shut down)
  photo: `/maps-tiles/thumbs/${slug}.jpg`
}));
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{lang==='zh' ? `${country.name.zh}捷運與鐵路路線圖` : `${country.name.en} Metro Maps`} | Metliner</title>
  <meta name="description" content={`Metro and rail maps for cities across ${country.name.en} by Metliner.`} />
  <Seo />
  <Icons />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>

<nav id="nav" class="solid">
  <div class="wrap">
    <a href={base} class="brand"><img src="/img/logo.png" alt="Metliner logo" />metliner</a>
    <div class="navlinks">
      <a href={`${base}/maps`}>{ui.maps}</a>
      <a href={`${base}/about-us`}>{ui.about}</a>
      <a href={`${base}/contact-us`}>{ui.contact}</a>
    </div>
    <ThemeToggle lang={lang} />
  </div>
</nav>
<div class="brand-bar"><i></i><i></i><i></i><i></i><i></i></div>

<header class="ctry-hero" style={`--c:${color}`}>
  <div class="wrap">
    <a class="back" href={`${base}/maps/${contKey}`}>
      <img src="/arrows/left-black.png" alt="" />{ui.back} {continent.name[lang]}
    </a>
    <h1>{country.name[lang]}</h1>
    <div class="native">{country.native || country.name.en}</div>
  </div>
</header>

<main class="wrap ctry-body">
  <div class="city-grid">
    {cities.map(city => (
      <a class="ccard" href={`${base}/maps/${contKey}/${countryKey}/${city.slug}`}>
        <div class="thumb"><img src={city.photo} alt={(allCities[city.slug]||{}).mapAlt ? allCities[city.slug].mapAlt[lang] : `${city.nameEn} metro map`} loading="lazy" /></div>
        <div class="cfoot"><span class="dot" style={`background:${color}`}></span>{city.name}</div>
      </a>
    ))}
  </div>
</main>

<footer><div class="wrap">
  <h3>{lang==='zh'?'聯絡我們':'Contact Us'}</h3>
  <p>{lang==='zh'?'有任何建議或問題嗎？透過電子郵件與我們聯絡：':'Any suggestions or concerns? Contact us through our email:'}<br /><a href="mailto:metliner64@gmail.com">metliner64@gmail.com</a></p>
  <p class="f-form">{lang==='zh'?'或是透過表單聯絡我們：':'Or reach us through our form:'} <a href="https://forms.gle/yXgh2pHnQRBxDBMP9" target="_blank" rel="noopener">{lang==='zh'?'填寫聯絡表單':'Fill in the contact form'}</a></p>
  <div class="social"><a href="#">Instagram</a><a href="#">X</a><a href="#">Pinterest</a><a href="#">Threads</a></div>
</div></footer>

<style>
  /* global five-colour brand bar under the nav */
  .brand-bar{display:flex;height:6px;width:100%}
  .brand-bar i{flex:1;display:block}
  .brand-bar i:nth-child(1){background:#e0483a}
  .brand-bar i:nth-child(2){background:#f5a623}
  .brand-bar i:nth-child(3){background:#3aa06a}
  .brand-bar i:nth-child(4){background:#2f7fd1}
  .brand-bar i:nth-child(5){background:#8e44c9}

  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:var(--font);color:var(--text);background:#fff;line-height:1.6}
  img{display:block;max-width:100%}
  .wrap{max-width:var(--page-max);margin:0 auto;padding:0 24px}

  nav{position:sticky;top:0;z-index:50;background:rgba(10,19,46,.97);backdrop-filter:blur(8px)}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
  .brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:400;font-size:20px;text-decoration:none}
  .brand img{height:38px;width:auto}
  .navlinks{display:flex;gap:22px;align-items:center}
  .navlinks a{color:#fff;text-decoration:none;font-size:15px;font-weight:400}
  .navlinks a:hover{color:var(--yellow)}
  .lang{color:#fff;border:1px solid rgba(255,255,255,.4);padding:5px 12px;border-radius:20px;font-size:14px}

  .ctry-hero{background:#fff;padding:44px 0 32px;border-bottom:8px solid var(--c)}
  .ctry-hero .back{display:inline-flex;align-items:center;gap:8px;color:#555;text-decoration:none;font-size:14px;font-weight:600}
  .ctry-hero .back img{width:22px;height:22px}
  .ctry-hero .back:hover{color:var(--navy)}
  .ctry-hero h1{color:var(--navy);font-size:64px;font-weight:800;line-height:1;margin:14px 0 0;letter-spacing:-.02em}
  .ctry-hero .native{color:#8a8f9c;font-size:18px;font-weight:500;margin-top:4px}

  .ctry-body{padding:48px 24px 80px}
  .city-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
  .ccard{text-decoration:none;color:inherit;display:block;transition:transform .15s,box-shadow .15s;border-radius:6px}
  .ccard:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(10,19,46,.16)}
  .ccard .thumb{aspect-ratio:4/3;border-radius:6px 6px 0 0;overflow:hidden;background:#e9e9e9}
  .ccard .thumb img{width:100%;height:100%;object-fit:cover}
  .ccard .cfoot{display:flex;align-items:center;gap:10px;background:var(--navy);color:#fff;
    padding:13px 16px;font-weight:700;font-size:18px;border-radius:0 0 6px 6px}
  .ccard .cfoot .dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}

  footer{background:var(--navy);color:#dfe4ef;padding:56px 0 72px}
  footer h3{color:#fff;font-size:28px;font-weight:800;margin-bottom:18px}
  footer a{color:var(--yellow);text-decoration:none}
  footer .social{display:flex;gap:16px;margin-top:14px;font-size:16px;font-weight:700}

  @media(max-width:980px){ .city-grid{grid-template-columns:repeat(3,1fr)} }
  @media(max-width:680px){
    .ctry-hero h1{font-size:44px}
    .city-grid{grid-template-columns:1fr 1fr;gap:16px}
    .navlinks{display:none}
  }
</style>
</body>
</html>
