---
import Icons from '../components/Icons.astro';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../config/theme.css';
import cities from '../data/cities.json';
import home from '../data/home.json';
import geo from '../data/geo.json';
import cityNames from '../data/city-names.json';

const { lang = 'en' } = Astro.props;
const ui = {
  en: { maps:'Maps', metraveler:'Metraveler', about:'About us', contact:'Contact us', langLabel:'English', explore:'Explore' },
  zh: { maps:'地圖', metraveler:'Metraveler', about:'關於我們', contact:'聯絡我們', langLabel:'繁體中文', explore:'探索' }
}[lang];
const base = lang === 'en' ? '/english' : '/zh';

// continent colours (line palette)
const CONT_COLOR = { asia:'#f5a623', america:'#e0483a', europe:'#2f7fd1', oceania:'#8e44c9', africa:'#3aa06a' };
// which continent a homepage-featured city belongs to (for cities not yet in cities.json)
const CITY_CONT = {
  xiamen:'asia', 'los-angeles':'america', seattle:'america', dallas:'america',
  montreal:'america', osaka:'asia', 'san-francisco':'america', copenhagen:'europe',
  hiroshima:'asia', busan:'asia', paris:'europe', beijing:'asia', 'new-york':'america',
  taipei:'asia', singapore:'asia'
};

// helper: turn a slug into a card {name, href, img, color}
function card(slug){
  const c = cities[slug];
  const cont = (c && c.continent) || CITY_CONT[slug] || 'asia';
  const color = CONT_COLOR[cont] || '#f5a623';
  if(c) return { name: c.name[lang], href: `${base}/maps/${c.continent}/${c.country}/${c.slug}`, img: c.map.src, color, alt: c.mapLabel[lang] };
  const nice = slug.split('-').map(w=>w[0].toUpperCase()+w.slice(1)).join(' ');
  return { name: nice, href: '#', img: '/maps/taipei_2026.jpg', color };
}
const latest = home.latestStops.map(card);
const hubs = home.transferHubs.map(card);
const sp = home.spotlight;

// Chinese names for the world map (used on /zh/ only)
const zhCountries = Object.fromEntries(Object.values(geo).flatMap(c => Object.entries(c.countries||{}).map(([k,v]) => [k, v.name.zh])));
const zhContinents = Object.fromEntries(Object.entries(geo).map(([k,v]) => [k, v.name.zh]));
const zhCities = Object.fromEntries(Object.entries(cityNames).map(([k,v]) => [k, v.zh]));

// Name shown in the browser tab and in search results (the big heading on the page stays home.title)
const siteName = lang === 'zh' ? 'Metliner — 100+ 座城市的地鐵路線圖' : 'Metliner — Metro Maps of 100+ Cities';
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{siteName}</title>
  <meta name="description" content={home.tagline[lang]} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"WebSite",
    "name":"Metliner","alternateName":["metliner","Metliner 捷線者"],
    "url":"https://www.metliner.com/"
  })} />
  <Seo />
  <Icons />
  <meta property="og:title" content={siteName} />
  <meta property="og:description" content={home.tagline[lang]} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>

<nav id="nav">
  <div class="wrap">
    <a href={base} class="brand"><img src="/img/logo.png" alt="Metliner logo" />metliner</a>
    <div class="navlinks">
      <a href={`${base}/maps`}>{ui.maps}</a>
      <a href={`${base}/about-us`}>{ui.about}</a>
      <a href={`${base}/contact-us`}>{ui.contact}</a>
    </div>
    <ThemeToggle lang={lang} />
  </div>
</nav>
<div class="brand-bar"><i></i><i></i><i></i><i></i><i></i></div>

<header class="home-hero">
  <div class="hero-map" id="hero-map"></div>
  <div class="hero-veil"></div>
  <div class="wrap hero-inner">
    <h1>{home.title[lang]}</h1>
  </div>
</header>

<!-- ROUTE MAP -->
<section class="route-map">
  <div class="wrap">
    <div class="sec-head">
      <img class="arrow" src="/arrows/down-left.png" alt="" />
      <div><div class="lines"><i></i><i></i><i></i><i></i><i></i></div><h2>{home.sections.routeMap[lang]}</h2><p>{home.sections.routeMapSub[lang]}</p></div>
    </div>
    <div class="worldmap-wrap"><div id="map"></div></div>
    <div class="continents">
      {home.continents.map((c) => (
        <a class="cont" href={`${base}/maps/${c.slug}`} style={`--c:${geo[c.slug].color}`}><span class="dot"></span>{c[lang]}</a>
      ))}
    </div>
  </div>
</section>

<!-- LATEST STOPS -->
<section class="cards-sec cream">
  <div class="wrap">
    <div class="sec-head">
      <img class="arrow" src="/arrows/right.png" alt="" />
      <div><div class="lines"><i></i><i></i><i></i><i></i><i></i></div><h2>{home.sections.latestStops[lang]}</h2><p>{home.sections.latestStopsSub[lang]}</p></div>
    </div>
    <div class="cards four">
      {latest.map((c) => (
        <a class="ecard" href={c.href}>
          <div class="thumb"><img src={c.img} alt={c.alt || c.name} loading="lazy" /></div>
          <div class="platefoot"><span class="dot" style={`background:${c.color}`}></span>{c.name}</div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- FEATURED WORKS -->
<section class="cards-sec">
  <div class="wrap">
    <div class="sec-head">
      <img class="arrow" src="/arrows/right.png" alt="" />
      <div><div class="lines"><i></i><i></i><i></i><i></i><i></i></div><h2>{home.sections.transferHubs[lang]}</h2></div>
    </div>
    <div class="cards three">
      {hubs.map((c) => (
        <a class="ecard" href={c.href}>
          <div class="thumb"><img src={c.img} alt={c.alt || c.name} loading="lazy" /></div>
          <div class="platefoot"><span class="dot" style={`background:${c.color}`}></span>{c.name}</div>
        </a>
      ))}
    </div>
  </div>
</section>

{/* METRAVELER SPOTLIGHT — hidden for now, un-comment to restore
<section class="spotlight">
  <div class="wrap sp-grid">
    <div class="sp-text">
      <span class="sp-label">{sp.label[lang]}</span>
      <h2>{lang==='zh' ? `歡迎來到${sp.city[lang]}，${sp.country[lang]}` : `Welcome to ${sp.city[lang]}, ${sp.country[lang]}`}</h2>
      <p>{sp.body[lang]}</p>
    </div>
    <div class="sp-ctas">
      <a class="sp-cta" href={`${base}/metraveler`}>
        <strong>{sp.cta1[lang]}</strong><span>{sp.cta1sub[lang]}</span>
      </a>
      <a class="sp-cta" href={`${base}/maps`}>
        <strong>{sp.cta2[lang]}</strong><span>{sp.cta2sub[lang]}</span>
      </a>
    </div>
  </div>
</section>
*/}

<footer><div class="wrap">
  <h3>{lang==='zh'?'聯絡我們':'Contact Us'}</h3>
  <p>{lang==='zh'?'有任何建議或問題嗎？透過電子郵件與我們聯絡：':'Any suggestions or concerns? Contact us through our email:'}<br /><a href="mailto:metliner64@gmail.com">metliner64@gmail.com</a></p>
  <p class="f-form">{lang==='zh'?'或是透過表單聯絡我們：':'Or reach us through our form:'} <a href="https://forms.gle/yXgh2pHnQRBxDBMP9" target="_blank" rel="noopener">{lang==='zh'?'填寫聯絡表單':'Fill in the contact form'}</a></p>
  <div class="social"><a href="#">Instagram</a><a href="#">X</a><a href="#">Pinterest</a><a href="#">Threads</a></div>
</div></footer>

<style>
  /* global five-colour brand bar under the nav */
  .brand-bar{display:flex;height:6px;width:100%}
  .brand-bar i{flex:1;display:block}
  .brand-bar i:nth-child(1){background:#e0483a}
  .brand-bar i:nth-child(2){background:#f5a623}
  .brand-bar i:nth-child(3){background:#3aa06a}
  .brand-bar i:nth-child(4){background:#2f7fd1}
  .brand-bar i:nth-child(5){background:#8e44c9}

  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:var(--font);color:var(--text);background:#fff;line-height:1.6}
  img{display:block;max-width:100%}
  .wrap{max-width:var(--page-max);margin:0 auto;padding:0 24px}

  nav{position:fixed;top:0;left:0;right:0;z-index:50;transition:background .3s,box-shadow .3s;background:transparent}
  nav.scrolled{background:rgba(10,19,46,.97);backdrop-filter:blur(8px);box-shadow:0 2px 18px rgba(0,0,0,.2)}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
  .brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:400;font-size:20px;text-decoration:none}
  .brand img{height:38px;width:auto}
  .navlinks{display:flex;gap:22px;align-items:center}
  .navlinks a{color:#fff;text-decoration:none;font-size:15px;font-weight:400;text-shadow:0 1px 3px rgba(0,0,0,.35)}
  nav.scrolled .navlinks a{text-shadow:none}
  .navlinks a:hover{color:var(--yellow)}
  .lang{color:#fff;border:1px solid rgba(255,255,255,.4);padding:5px 12px;border-radius:20px;font-size:14px}

  .home-hero{position:relative;min-height:640px;display:flex;align-items:center;overflow:hidden;background:#1e2126}
  .hero-map{position:absolute;inset:-4%;background:url('/img/world-hero.jpg') center/cover no-repeat;
    transition:transform .3s ease-out;will-change:transform}
  /* left-side veil so the headline is always legible over the map */
  .home-hero .hero-veil{position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(90deg, rgba(20,22,27,.92) 0%, rgba(20,22,27,.6) 38%, rgba(20,22,27,.1) 70%, rgba(20,22,27,.35) 100%)}
  .home-hero::after{content:'';position:absolute;left:0;right:0;bottom:0;height:8px;z-index:3;
    background:linear-gradient(90deg,#e0483a 0 20%,#f5a623 20% 40%,#3aa06a 40% 60%,#2f7fd1 60% 80%,#8e44c9 80% 100%)}
  .hero-inner{position:relative;z-index:2;padding:150px 24px 110px;pointer-events:none}
  .home-hero h1{color:#fff;font-size:112px;font-weight:600;line-height:.95;letter-spacing:-.02em;
    position:relative;display:inline-block;isolation:isolate}
  /* soft blur behind the title only; edges fade out so there is no visible box */
  .home-hero h1::before{content:'';position:absolute;z-index:-1;inset:-.28em -.4em;border-radius:.4em;
    -webkit-backdrop-filter:blur(7px);backdrop-filter:blur(7px);
    -webkit-mask-image:radial-gradient(ellipse closest-side, #000 62%, transparent 100%);
    mask-image:radial-gradient(ellipse closest-side, #000 62%, transparent 100%)}
  .home-hero .slogan{color:#e8ecf5;font-size:24px;font-weight:600;margin-top:28px;letter-spacing:.01em}

  /* subway line colours (from logo / metro convention) */
  .lines{display:flex;gap:6px;margin-bottom:14px}
  .lines i{width:26px;height:7px;border-radius:4px;display:block}
  .lines i:nth-child(1){background:#e0483a}
  .lines i:nth-child(2){background:#f5a623}
  .lines i:nth-child(3){background:#3aa06a}
  .lines i:nth-child(4){background:#2f7fd1}
  .lines i:nth-child(5){background:#8e44c9}

  .sec-head{display:flex;align-items:flex-start;gap:22px;margin-bottom:36px}
  .sec-head .arrow{width:60px;height:60px;flex-shrink:0}
  .sec-head h2{font-size:44px;font-weight:800;color:var(--navy);line-height:1.05}
  .sec-head p{font-size:17px;font-weight:500;color:#333;margin-top:6px}

  /* platform name-plate foot on each card */
  .platefoot{display:flex;align-items:center;gap:10px;background:#141F2B;color:#fff;
    padding:12px 16px;font-weight:700;font-size:19px;border-radius:0 0 4px 4px}
  .platefoot .dot{width:13px;height:13px;border-radius:50%;flex-shrink:0}
  .platefoot .dot[data-line="0"]{background:#e0483a}
  .platefoot .dot[data-line="1"]{background:#f5a623}
  .platefoot .dot[data-line="2"]{background:#3aa06a}
  .platefoot .dot[data-line="3"]{background:#2f7fd1}
  .platefoot .dot[data-line="4"]{background:#8e44c9}

  .route-map{padding:72px 0}
  .worldmap-wrap{max-width:100%;margin:0 auto}
  #map{width:100%}
  .continents{display:flex;flex-wrap:wrap;gap:14px;margin-top:28px}
  /* continent plates: rectangular outline, coloured dot, name */
  .cont{display:inline-flex;align-items:center;gap:12px;background:transparent;border:2px solid #141F2B;color:#141F2B;
    font-weight:700;font-size:19px;padding:14px 30px 14px 22px;border-radius:4px;text-decoration:none;
    transition:border-color .15s,transform .15s,box-shadow .15s}
  .cont .dot{width:13px;height:13px;border-radius:50%;background:var(--c);flex-shrink:0}
  .cont:hover{border-color:var(--c);transform:translateY(-2px);box-shadow:0 8px 20px rgba(10,19,46,.12)}

  .cards-sec{padding:72px 0}
  .cards-sec.cream{background:var(--cream)}
  .cards{display:grid;gap:22px}
  .cards.four{grid-template-columns:repeat(4,1fr)}
  .cards.three{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
  .ecard{text-decoration:none;color:inherit;display:block;transition:transform .15s,box-shadow .15s;border-radius:4px}
  .ecard:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(10,19,46,.18)}
  .ecard .thumb{aspect-ratio:1/1;border-radius:4px 4px 0 0;overflow:hidden;background:#0d1330}
  .ecard .thumb img{width:100%;height:100%;object-fit:cover}

  .spotlight{background:var(--navy);padding:80px 0;color:#fff}
  .sp-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:center}
  .sp-label{display:inline-block;background:var(--yellow);color:var(--navy);font-weight:800;font-size:14px;padding:5px 16px;border-radius:20px;letter-spacing:.04em;margin-bottom:20px}
  .sp-text h2{font-size:34px;font-weight:800;line-height:1.15;margin-bottom:18px}
  .sp-text p{color:#c7cfe0;font-size:16.5px;line-height:1.75}
  .sp-ctas{display:flex;flex-direction:column;gap:16px}
  .sp-cta{background:var(--yellow);color:var(--navy);text-decoration:none;border-radius:8px;padding:22px 24px;display:block;transition:transform .15s}
  .sp-cta:hover{transform:translateY(-3px)}
  .sp-cta strong{display:block;font-size:22px;font-weight:800}
  .sp-cta span{display:block;font-size:14px;font-weight:600;margin-top:4px;opacity:.85}

  footer{background:var(--navy);color:#dfe4ef;padding:56px 0 72px;border-top:1px solid rgba(255,255,255,.1)}
  footer h3{color:#fff;font-size:28px;font-weight:800;margin-bottom:18px}
  footer a{color:var(--yellow);text-decoration:none}
  footer .social{display:flex;gap:16px;margin-top:14px;font-size:16px;font-weight:700}

  @media(max-width:760px){
    .home-hero{min-height:460px}
    .home-hero h1{font-size:58px}
    .home-hero .slogan{font-size:19px}
    .home-hero .hero-veil{background:linear-gradient(180deg, rgba(20,22,27,.5) 0%, rgba(20,22,27,.85) 100%)}
    .sec-head h2{font-size:30px}.sec-head .arrow{width:48px;height:48px}
    .cards.four,.cards.three{grid-template-columns:1fr 1fr}
    .sp-grid{grid-template-columns:1fr;gap:32px}
    .sp-text h2{font-size:27px}
    .navlinks{display:none}
  }
</style>

<script>
  const nav=document.getElementById('nav');
  const onScroll=()=>{ if(window.scrollY>60) nav.classList.add('scrolled'); else nav.classList.remove('scrolled'); };
  window.addEventListener('scroll',onScroll); onScroll();
</script>

<script>
/* ── Hero: world map parallax follows the cursor ── */
(function(){
  const hero = document.querySelector('.home-hero');
  const map = document.getElementById('hero-map');
  if(!hero || !map) return;
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce) return;
  let tx=0, ty=0, cx=0, cy=0;
  hero.addEventListener('mousemove',(e)=>{
    const r=hero.getBoundingClientRect();
    // -1..1 from centre, small movement
    tx = ((e.clientX-r.left)/r.width - 0.5) * -28;
    ty = ((e.clientY-r.top)/r.height - 0.5) * -18;
  });
  hero.addEventListener('mouseleave',()=>{ tx=0; ty=0; });
  (function loop(){
    cx += (tx-cx)*0.06; cy += (ty-cy)*0.06;
    map.style.transform = `translate(${cx}px, ${cy}px) scale(1.06)`;
    requestAnimationFrame(loop);
  })();
})();
</script>

<!-- interactive world map (simplemaps) -->
<script is:inline>
  // hide the simplemaps trial watermark once the map renders
  (function(){
    function hideTrial(){
      document.querySelectorAll('#map a[href*="simplemaps.com"], #map text').forEach(function(el){
        var t=(el.textContent||'').toLowerCase();
        if(t.indexOf('simplemaps')!==-1 || t.indexOf('trial')!==-1){ el.style.display='none'; }
      });
    }
    var obs=new MutationObserver(function(){ hideTrial(); });
    document.addEventListener('DOMContentLoaded', function(){
      var m=document.getElementById('map'); if(m) obs.observe(m,{childList:true,subtree:true});
      hideTrial();
    });
    setTimeout(hideTrial,800); setTimeout(hideTrial,2000);
  })();
</script>
<script is:inline src="/worldmap/mapdata.js"></script>
{lang === 'zh' && (
  <script is:inline define:vars={{ zhCountries, zhCities, zhContinents }}>
    // Chinese pages: point the world map at /zh/ pages and show Chinese names
    (function(){
      var d = window.simplemaps_worldmap_mapdata; if(!d) return;
      var fix = function(u){ return u ? u.replace(/^\/english\//, '/zh/') : u; };
      Object.keys(d.state_specific||{}).forEach(function(k){
        var s = d.state_specific[k];
        var m = s.url && s.url.match(/\/maps\/[^/]+\/([^/]+)\/?$/);
        if(m && zhCountries[m[1]]) s.name = zhCountries[m[1]];
        if(s.description) s.description = s.description.replace(/^(\d+) cit(y|ies)$/, '$1 座城市');
        s.url = fix(s.url);
      });
      Object.keys(d.locations||{}).forEach(function(k){
        var l = d.locations[k];
        var m = l.url && l.url.match(/\/maps\/[^/]+\/([^/]+)\/([^/]+)\/?$/);
        if(m){
          var city = zhCities[m[2]], ctry = zhCountries[m[1]];
          if(city){ l.name = city; l.description = ctry ? city + '，' + ctry : city; }
        }
        l.url = fix(l.url);
      });
      Object.keys(d.regions||{}).forEach(function(k){
        var r = d.regions[k]; var z = zhContinents[(r.name||'').toLowerCase()];
        if(z) r.name = z; r.url = fix(r.url);
      });
    })();
  </script>
)}
<script is:inline src="/worldmap/worldmap.js"></script>
</body>
</html>
