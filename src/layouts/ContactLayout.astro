---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../config/theme.css';
import pages from '../data/pages.json';

const { lang = 'en' } = Astro.props;
const p = pages.contact;
const ui = {
  en: { maps:'Maps', metraveler:'Metraveler', about:'About us', contact:'Contact us', langLabel:'English', emailLabel:'CONTACT FORM', followLabel:'Follow along' },
  zh: { maps:'地圖', metraveler:'Metraveler', about:'關於我們', contact:'聯絡我們', langLabel:'繁體中文', emailLabel:'聯絡表單', followLabel:'追蹤我們' }
}[lang];
const base = lang === 'en' ? '/english' : '/zh';
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{p.title[lang]} | Metliner</title>
  <meta name="description" content={p.lead[lang]} />
  <link rel="canonical" href={`https://www.metliner.com${base}/contact-us`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>

<nav id="nav" class="solid">
  <div class="wrap">
    <a href={base} class="brand"><img src="/img/logo.png" alt="Metliner logo" />metliner</a>
    <div class="navlinks">
      <a href={`${base}/maps`}>{ui.maps}</a>
      <a href={`${base}/about-us`}>{ui.about}</a>
      <a href={`${base}/contact-us`}>{ui.contact}</a>
    </div>
    <ThemeToggle lang={lang} />
  </div>
</nav>
<div class="brand-bar"><i></i><i></i><i></i><i></i><i></i></div>

<header class="page-hero">
  <div class="wrap">
    <h1>{p.title[lang]}</h1>
  </div>
</header>

<main class="wrap page-body">
  <p class="lead">{p.lead[lang]}</p>

  <div class="contact-grid">
    <a class="contact-card" href={p.formUrl} target="_blank" rel="noopener">
      <span class="cc-label">{ui.emailLabel}</span>
      <span class="cc-value">{p.formCta[lang]}</span>
      <span class="cc-sub">{p.formSub[lang]}</span>
      <img class="cc-arrow" src="/arrows/right.png" alt="" />
    </a>
  </div>

  <p class="or-email">
    {lang==='zh' ? '或直接寫信給我們：' : 'Or email us directly at '}
    <a id="email-link" href="#" data-u="metliner64" data-d="gmail.com">…</a>
  </p>

  <div class="follow-head"><span class="kdot"></span>{ui.followLabel}</div>
  <div class="socials">
    {p.socials.map(s => (
      <a class="social-card" href={s.url} target="_blank" rel="noopener">
        <span class="s-name">{s.name}</span>
        <span class="s-handle">{s.handle}</span>
      </a>
    ))}
  </div>
</main>

<script>
  // assemble the email at runtime so scrapers can't read it from the HTML
  var el = document.getElementById('email-link');
  if (el) {
    var addr = el.getAttribute('data-u') + '@' + el.getAttribute('data-d');
    el.textContent = addr;
    el.setAttribute('href', 'mailto:' + addr);
  }
</script>

<footer><div class="wrap">
  <h3>{lang==='zh'?'聯絡我們':'Contact Us'}</h3>
  <p>{lang==='zh'?'有任何建議或問題嗎？':'Any suggestions or concerns?'} <a href={p.formUrl} target="_blank" rel="noopener">{lang==='zh'?'填寫聯絡表單':'Fill in the contact form'}</a></p>
</div></footer>

<style>
  /* global five-colour brand bar under the nav */
  .brand-bar{display:flex;height:6px;width:100%}
  .brand-bar i{flex:1;display:block}
  .brand-bar i:nth-child(1){background:#e0483a}
  .brand-bar i:nth-child(2){background:#f5a623}
  .brand-bar i:nth-child(3){background:#3aa06a}
  .brand-bar i:nth-child(4){background:#2f7fd1}
  .brand-bar i:nth-child(5){background:#8e44c9}

  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:var(--font);color:var(--text);background:#fff;line-height:1.6}
  img{display:block;max-width:100%}
  .wrap{max-width:840px;margin:0 auto;padding:0 24px}

  nav{position:sticky;top:0;z-index:50;background:rgba(10,19,46,.97);backdrop-filter:blur(8px)}
  nav .wrap{max-width:1180px;display:flex;align-items:center;justify-content:space-between;height:64px}
  .brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:400;font-size:20px;text-decoration:none}
  .brand img{height:38px;width:auto}
  .navlinks{display:flex;gap:22px;align-items:center}
  .navlinks a{color:#fff;text-decoration:none;font-size:15px;font-weight:400}
  .navlinks a:hover{color:var(--yellow)}
  .lang{color:#fff;border:1px solid rgba(255,255,255,.4);padding:5px 12px;border-radius:20px;font-size:14px}

  .page-hero{background:#fff;padding:64px 0 36px;border-bottom:1px solid #eee}
  .page-hero .lines{display:flex;gap:6px;margin-bottom:16px}
  .page-hero .lines i{width:30px;height:8px;border-radius:4px;display:block}
  .page-hero .lines i:nth-child(1){background:#e0483a}
  .page-hero .lines i:nth-child(2){background:#f5a623}
  .page-hero .lines i:nth-child(3){background:#3aa06a}
  .page-hero .lines i:nth-child(4){background:#2f7fd1}
  .page-hero .lines i:nth-child(5){background:#8e44c9}
  .page-hero h1{color:var(--navy);font-size:56px;font-weight:800;line-height:1;letter-spacing:-.02em}

  .page-body{padding:48px 24px 88px}
  .lead{font-size:22px;line-height:1.55;color:var(--navy);font-weight:600;max-width:56ch}

  .contact-grid{margin-top:32px}
  .contact-card{position:relative;display:flex;flex-direction:column;text-decoration:none;background:var(--navy);
    border-radius:12px;padding:28px 30px;transition:transform .15s,box-shadow .15s}
  .contact-card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(10,19,46,.2)}
  .cc-label{color:var(--yellow);font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .cc-value{color:#fff;font-size:26px;font-weight:700;margin-top:6px}
  .cc-sub{color:#aab4cc;font-size:15px;font-weight:400;margin-top:6px;max-width:46ch}
  .cc-arrow{position:absolute;right:26px;top:50%;transform:translateY(-50%);width:34px;height:34px;transition:transform .15s}
  .contact-card:hover .cc-arrow{transform:translateY(-50%) translateX(4px)}
  .or-email{margin-top:20px;color:#555;font-size:15px}
  .or-email a{color:var(--navy);font-weight:700;text-decoration:underline;text-underline-offset:2px}

  .follow-head{display:inline-flex;align-items:center;gap:9px;margin-top:52px;margin-bottom:16px;
    color:#8a8f9c;font-size:12.5px;font-weight:700;letter-spacing:.2em}
  .follow-head .kdot{width:8px;height:8px;border-radius:50%;background:var(--yellow)}
  .socials{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
  .social-card{display:flex;flex-direction:column;text-decoration:none;background:var(--cream);
    border:1.5px solid #ececec;border-radius:10px;padding:20px 22px;transition:all .14s}
  .social-card:hover{border-color:var(--yellow);transform:translateY(-3px)}
  .s-name{color:var(--navy);font-size:19px;font-weight:800}
  .s-handle{color:#888;font-size:14px;font-weight:500;margin-top:2px}

  footer{background:var(--navy);color:#dfe4ef;padding:56px 0 72px}
  footer .wrap{max-width:840px}
  footer h3{color:#fff;font-size:28px;font-weight:800;margin-bottom:18px}
  footer a{color:var(--yellow);text-decoration:none}

  @media(max-width:680px){
    .page-hero h1{font-size:42px}
    .lead{font-size:19px}
    .socials{grid-template-columns:1fr}
    .navlinks{display:none}
  }
</style>
</body>
</html>
