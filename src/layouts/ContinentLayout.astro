---
import Icons from '../components/Icons.astro';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../config/theme.css';

const { continent, contKey, lang = 'en' } = Astro.props;
const ui = {
  en: { maps:'Maps', metraveler:'Metraveler', about:'About us', contact:'Contact us', langLabel:'English', cities:'cities', city:'city', backToMaps:'All continents' },
  zh: { maps:'地圖', metraveler:'Metraveler', about:'關於我們', contact:'聯絡我們', langLabel:'繁體中文', cities:'座城市', city:'座城市', backToMaps:'所有大洲' }
}[lang];
const base = lang === 'en' ? '/english' : '/zh';
const color = continent.color;

const countries = Object.entries(continent.countries).map(([ck, c]) => ({
  key: ck,
  name: c.name[lang] || c.name.en,
  native: c.native || c.name.en
}));
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{lang==='zh' ? `${continent.name.zh}捷運與鐵路路線圖` : `${continent.name.en} Metro Maps`} | Metliner</title>
  <meta name="description" content={`Explore metro and rail maps across ${continent.name.en} by Metliner. Browse cities country by country.`} />
  <Seo />
  <Icons />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>

<nav id="nav" class="solid">
  <div class="wrap">
    <a href={base} class="brand"><img src="/img/logo.png" alt="Metliner logo" />metliner</a>
    <div class="navlinks">
      <a href={`${base}/maps`}>{ui.maps}</a>
      <a href={`${base}/about-us`}>{ui.about}</a>
      <a href={`${base}/contact-us`}>{ui.contact}</a>
    </div>
    <ThemeToggle lang={lang} />
  </div>
</nav>
<div class="brand-bar"><i></i><i></i><i></i><i></i><i></i></div>

<header class="cont-hero" style={`--c:${color}`}>
  <div class="wrap">
    <a class="back" href={`${base}/maps`}><img src="/arrows/left-black.png" alt="" />{ui.backToMaps}</a>
    <h1>{continent.name[lang]}</h1>
  </div>
</header>

<!-- OPTIONAL: continent route map goes here later -->

<main class="cont-body" style={`--c:${color}`}>
  <div class="line-list">
    <div class="rail"></div>
    {countries.map(country => (
      <a class="station" href={`${base}/maps/${contKey}/${country.key}`}>
        <span class="dot"></span>
        <span class="st-names">
          <span class="st-en">{country.name}</span>
          <span class="st-local">{country.native}</span>
        </span>
      </a>
    ))}
  </div>
</main>

<footer><div class="wrap">
  <h3>{lang==='zh'?'聯絡我們':'Contact Us'}</h3>
  <p>{lang==='zh'?'有任何建議或問題嗎？透過電子郵件與我們聯絡：':'Any suggestions or concerns? Contact us through our email:'}<br /><a href="mailto:metliner64@gmail.com">metliner64@gmail.com</a></p>
  <p class="f-form">{lang==='zh'?'或是透過表單聯絡我們：':'Or reach us through our form:'} <a href="https://forms.gle/yXgh2pHnQRBxDBMP9" target="_blank" rel="noopener">{lang==='zh'?'填寫聯絡表單':'Fill in the contact form'}</a></p>
  <div class="social"><a href="#">Instagram</a><a href="#">X</a><a href="#">Pinterest</a><a href="#">Threads</a></div>
</div></footer>

<style>
  /* global five-colour brand bar under the nav */
  .brand-bar{display:flex;height:6px;width:100%}
  .brand-bar i{flex:1;display:block}
  .brand-bar i:nth-child(1){background:#e0483a}
  .brand-bar i:nth-child(2){background:#f5a623}
  .brand-bar i:nth-child(3){background:#3aa06a}
  .brand-bar i:nth-child(4){background:#2f7fd1}
  .brand-bar i:nth-child(5){background:#8e44c9}

  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:var(--font);color:var(--text);background:#fff;line-height:1.6}
  img{display:block;max-width:100%}
  .wrap{max-width:var(--page-max);margin:0 auto;padding:0 24px}

  nav{position:sticky;top:0;z-index:50;background:rgba(10,19,46,.97);backdrop-filter:blur(8px)}
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
  .brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:400;font-size:20px;text-decoration:none}
  .brand img{height:38px;width:auto}
  .navlinks{display:flex;gap:22px;align-items:center}
  .navlinks a{color:#fff;text-decoration:none;font-size:15px;font-weight:400}
  .navlinks a:hover{color:var(--yellow)}
  .lang{color:#fff;border:1px solid rgba(255,255,255,.4);padding:5px 12px;border-radius:20px;font-size:14px}

  /* continent hero — white, matches home sections; coloured underline */
  .cont-hero{background:#fff;padding:44px 0 32px;position:relative;border-bottom:8px solid var(--c)}
  .cont-hero .back{display:inline-flex;align-items:center;gap:8px;color:#555;text-decoration:none;font-size:14px;font-weight:600}
  .cont-hero .back img{width:22px;height:22px}
  .cont-hero .back:hover{color:var(--navy)}
  .cont-hero h1{color:var(--navy);font-size:64px;font-weight:800;line-height:1;margin:14px 0 0;letter-spacing:-.02em}

  /* metro station-board list of countries — white to match home */
  .cont-body{background:#fff;padding:28px 0 72px}
  .line-list{position:relative;max-width:640px;margin:0 auto;padding:20px 24px}
  /* the coloured rail — thicker, centre at 69px */
  .rail{position:absolute;top:0;bottom:0;left:60px;width:18px;background:var(--c);border-radius:9px}
  .station{position:relative;display:flex;align-items:center;text-decoration:none;
    min-height:132px;padding-left:44px}
  /* outline station dot (white core + coloured ring), centred on the rail (rail centre = 69px) */
  .station .dot{position:absolute;left:61px;top:50%;margin-top:-8px;
    width:16px;height:16px;border-radius:50%;
    background:#fff;border:4px solid var(--c);box-shadow:0 0 0 3px #fff;z-index:2;transition:transform .15s}
  .station:hover .dot{transform:scale(1.3)}
  .st-names{flex:1;padding-left:64px;text-align:left}
  .st-en{display:block;color:var(--navy);font-size:40px;font-weight:800;line-height:1.05}
  .st-local{display:block;color:#8a8f9c;font-size:16px;font-weight:500;margin-top:4px}
  .station:hover .st-en{color:var(--c)}

  footer{background:var(--navy);color:#dfe4ef;padding:56px 0 72px}
  footer h3{color:#fff;font-size:28px;font-weight:800;margin-bottom:18px}
  footer a{color:var(--yellow);text-decoration:none}
  footer .social{display:flex;gap:16px;margin-top:14px;font-size:16px;font-weight:700}

  @media(max-width:760px){
    .cont-hero h1{font-size:44px}
    .country-head h2{font-size:22px}
    .navlinks{display:none}
  }
</style>
</body>
</html>
