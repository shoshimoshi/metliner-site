---
// Mordle: daily "guess the city from its blurred map" game.
import Icons from '../components/Icons.astro';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../config/theme.css';
import cities from '../data/cities.json';
import geo from '../data/geo.json';
import mordle from '../data/mordle.json';

const { lang = 'en' } = Astro.props;
const base = lang === 'en' ? '/english' : '/zh';
const T = {
  en: { maps:'Maps', about:'About us', contact:'Contact us',
        title:'Mordle | Guess the City from Its Metro Map | Metliner',
        desc:'A daily game from Metliner: guess the city from a blurred metro map in five tries.',
        placeholder:'Guess a city', head:['City','Continent','Country','Year'],
        won:'You got it: ', lost:'The answer was ', share:'Share image', copy:'Copy text', copied:'Copied',
        selected:'Selected, copy it manually', tip:'Sharing is not available in this browser, so the image was downloaded. Post it to Threads or Instagram with your own caption.',
        next:'Next city in', view:'See the full map', again:'Come back tomorrow for a new city.',
        boxes:'Guesses', earlier:'earlier', later:'later' },
  zh: { maps:'地圖', about:'關於我們', contact:'聯絡我們',
        title:'Mordle｜看地鐵圖猜城市｜Metliner',
        desc:'Metliner 的每日小遊戲：從模糊的路線圖猜出是哪座城市，一共五次機會。',
        placeholder:'猜一個城市，中英文都可以', head:['城市','洲','國家','年份'],
        won:'答對了：', lost:'答案是 ', share:'分享圖片', copy:'複製文字', copied:'已複製',
        selected:'已選取，請手動複製', tip:'這個瀏覽器不能直接分享，已幫你下載圖片，再貼到 Threads 或 IG 加上你的文案。',
        next:'下一題倒數', view:'看完整地圖', again:'明天再來猜下一座城市。',
        boxes:'猜測次數', earlier:'更早', later:'更晚' }
}[lang];

// every city can be guessed; only cities in the schedule can be answers
const C = Object.values(cities).map(c => [
  c.slug, c.name.zh, c.name.en, c.continent, c.countryName[lang], mordle.years[c.slug],
  `${base}/maps/${c.continent}/${c.country}/${c.slug}/`, c.map.src,
  (c.intro[lang].match(lang === 'zh' ? /^[^。]*。/ : /^.*?\.(\s|$)/) || [''])[0].trim()
]);
const CONT = Object.fromEntries(Object.entries(geo).map(([k, v]) => [k, v.name[lang]]));
const cfg = { lang, launch: mordle.launch, schedule: mordle.schedule, T, C, CONT };
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{T.title}</title>
  <meta name="description" content={T.desc} />
  <Seo />
  <Icons />
  <meta property="og:title" content="Mordle by Metliner" />
  <meta property="og:description" content={T.desc} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>

<nav id="nav" class="solid">
  <div class="wrap">
    <a href={base} class="brand"><img src="/img/logo.png" alt="Metliner logo" />metliner</a>
    <div class="navlinks">
      <a href={`${base}/maps`}>{T.maps}</a>
      <a href={`${base}/mordle`}>Mordle</a>
      <a href={`${base}/about-us`}>{T.about}</a>
      <a href={`${base}/contact-us`}>{T.contact}</a>
    </div>
    <ThemeToggle lang={lang} />
  </div>
</nav>
<div class="brand-bar"><i></i><i></i><i></i><i></i><i></i></div>

<main class="mo">
  <header class="mo-head">
    <h1>Mordle</h1>
    <div class="mo-by">by Metliner · <span id="mo-num"></span></div>
  </header>

  <div class="mo-frame" id="mo-frame">
    <img alt="" id="mo-i0"><img alt="" id="mo-i1"><img alt="" id="mo-i2"><img alt="" id="mo-i3"><img alt="" id="mo-i4"><img alt="" id="mo-i5" class="full">
  </div>

  <div class="mo-boxes" id="mo-boxes" aria-label={T.boxes}></div>

  <div class="mo-guess" id="mo-guess">
    <label for="mo-q" class="mo-sr">{T.placeholder}</label>
    <input id="mo-q" type="text" autocomplete="off" placeholder={T.placeholder} role="combobox" aria-expanded="false" aria-controls="mo-sugg" aria-autocomplete="list">
    <ul class="mo-sugg" id="mo-sugg" role="listbox" hidden></ul>
  </div>

  <section class="mo-end" id="mo-end" hidden>
    <div class="mo-ans" id="mo-ans"></div>
    <p class="mo-intro" id="mo-intro"></p>
    <a class="mo-link" id="mo-link" href="#">{T.view} →</a>
    <img class="mo-card" id="mo-card" alt="Mordle result card">
    <div class="mo-acts">
      <button type="button" class="primary" id="mo-share">{T.share}</button>
      <button type="button" id="mo-copy">{T.copy}</button>
    </div>
    <p class="mo-tip" id="mo-tip" hidden>{T.tip}</p>
    <pre class="mo-text" id="mo-text" hidden></pre>
    <p class="mo-next">{T.next} <b id="mo-count"></b></p>
  </section>

  <div class="mo-rows" id="mo-rows">
    <div class="mo-row mo-rowhead" id="mo-rowhead" hidden>{T.head.map(h => <span>{h}</span>)}</div>
  </div>
</main>

<footer><div class="wrap">
  <h3>{lang==='zh'?'聯絡我們':'Contact Us'}</h3>
  <p>{lang==='zh'?'有任何建議或問題嗎？透過電子郵件與我們聯絡：':'Any suggestions or concerns? Contact us through our email:'}<br /><a href="mailto:metliner64@gmail.com">metliner64@gmail.com</a></p>
</div></footer>

<style>
  .brand-bar{display:flex;height:6px;width:100%}
  .brand-bar i{flex:1;display:block}
  .brand-bar i:nth-child(1){background:#e0483a}.brand-bar i:nth-child(2){background:#f5a623}.brand-bar i:nth-child(3){background:#3aa06a}.brand-bar i:nth-child(4){background:#2f7fd1}.brand-bar i:nth-child(5){background:#8e44c9}
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:var(--font);color:var(--text);background:#F6F5F1;line-height:1.5}
  img{display:block;max-width:100%}
  .wrap{max-width:1100px;margin:0 auto;padding:0 24px}
  nav{position:sticky;top:0;z-index:50;background:rgba(10,19,46,.97);backdrop-filter:blur(8px)}
  nav .wrap{max-width:1180px;display:flex;align-items:center;justify-content:space-between;height:64px}
  .brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:400;font-size:20px;text-decoration:none}
  .brand img{height:38px;width:auto}
  .navlinks{display:flex;gap:22px;align-items:center}
  .navlinks a{color:#fff;text-decoration:none;font-size:15px;font-weight:400}
  .navlinks a:hover{color:var(--yellow)}
  footer{background:var(--navy);color:#dfe4ef;padding:56px 0 72px}
  footer h3{color:#fff;font-size:28px;font-weight:800;margin-bottom:18px}
  footer a{color:var(--yellow);text-decoration:none}
  @media(max-width:760px){ .navlinks{display:none} }
</style>

<style is:global>
  .mo{--mo-panel:#fff;--mo-ink:#0A132E;--mo-muted:#5d6475;--mo-line:#d9dbe2;--mo-chip:#eceef3;
    max-width:520px;margin:0 auto;padding:28px 16px 64px;display:flex;flex-direction:column;gap:18px;color:var(--mo-ink)}
  html[data-theme="dark"] .mo{--mo-panel:#121212;--mo-ink:#f2f3f7;--mo-muted:#a3a7b3;--mo-line:#2c2f36;--mo-chip:#1d1f24}
  html[data-theme="dark"] body{background:#000 !important}
  .mo [hidden]{display:none !important}
  .mo-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .mo-head h1{font-family:'Montserrat',var(--font);font-weight:800;font-size:clamp(40px,10vw,54px);letter-spacing:-.02em;line-height:1}
  .mo-by{font-family:'Montserrat',var(--font);font-weight:600;font-size:14px;color:var(--mo-muted);margin-top:4px}
  .mo-frame{position:relative;width:100%;aspect-ratio:1/1;border-radius:6px;overflow:hidden;background:#0d1424}
  .mo-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;
    filter:blur(calc(var(--b,0) * var(--k,1) * 1px)) grayscale(var(--g,0));transform:scale(1.04);transition:opacity .45s ease,filter .6s ease}
  .mo-frame img.on{opacity:1}
  .mo-frame img.full{object-fit:contain;transform:none;filter:none}
  .mo-boxes{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
  .mo-box{aspect-ratio:1/1;max-height:56px;width:100%;border-radius:6px;border:2px solid var(--mo-line);transition:background .3s,border-color .3s}
  .mo-box.now{border-color:var(--mo-ink)}
  .mo-box.miss{background:#e0483a;border-color:#e0483a}
  .mo-box.hit{background:#3aa06a;border-color:#3aa06a}
  .mo-guess{position:relative}
  .mo-guess input{width:100%;font:500 17px var(--font);padding:13px 14px;border-radius:6px;border:2px solid var(--mo-line);background:var(--mo-panel);color:var(--mo-ink)}
  .mo-guess input:focus{border-color:var(--mo-ink);outline:none}
  .mo-guess.shake input{animation:mo-shake .3s}
  @keyframes mo-shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
  .mo-sugg{position:absolute;left:0;right:0;top:calc(100% + 4px);z-index:5;background:var(--mo-panel);border:1px solid var(--mo-line);border-radius:6px;
    list-style:none;margin:0;padding:4px 0;max-height:260px;overflow:auto;box-shadow:0 12px 28px rgba(0,0,0,.18)}
  .mo-sugg li{padding:9px 14px;cursor:pointer;display:flex;justify-content:space-between;gap:12px;color:var(--mo-ink)}
  .mo-sugg li small{color:var(--mo-muted)}
  .mo-sugg li[aria-selected="true"],.mo-sugg li:hover{background:var(--mo-chip)}
  .mo-rows{display:flex;flex-direction:column;gap:8px}
  .mo-row{display:grid;grid-template-columns:minmax(0,1.3fr) repeat(3,minmax(0,1fr));gap:6px}
  .mo-row > span{min-width:0;border-radius:5px;padding:8px 6px;text-align:center;font-size:13.5px;font-weight:600;background:var(--mo-chip);
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--mo-muted)}
  .mo-row > span.name{text-align:left;padding-left:10px;font-weight:700;background:transparent;border:1.5px solid var(--mo-line);color:var(--mo-ink)}
  .mo-row > span.ok{background:#3aa06a;color:#fff}
  .mo-row > span.yr{font-variant-numeric:tabular-nums}
  .mo-rowhead > span{background:transparent !important;border:0 !important;font:700 11px 'Montserrat',var(--font);letter-spacing:.12em;text-transform:uppercase;padding:0 6px}
  .mo-rowhead > span:first-child{text-align:left;padding-left:10px}
  .mo-end{display:flex;flex-direction:column;gap:12px;background:var(--mo-panel);border:1px solid var(--mo-line);border-radius:6px;padding:16px}
  .mo-ans{font:800 26px 'Montserrat',var(--font)}
  .mo-intro{font-size:15px;color:var(--mo-muted)}
  .mo-link{font-weight:700;color:#2f7fd1;text-decoration:none}
  .mo-card{width:100%;border-radius:6px}
  .mo-acts{display:flex;gap:10px;flex-wrap:wrap}
  .mo-acts button{font:700 15px 'Montserrat',var(--font);padding:11px 16px;border-radius:6px;cursor:pointer;border:1.5px solid var(--mo-ink);background:transparent;color:var(--mo-ink)}
  .mo-acts .primary{background:#FFC816;border-color:#FFC816;color:#0A132E}
  .mo-acts button:focus-visible,.mo-guess input:focus-visible{outline:2px solid #FFC816;outline-offset:2px}
  .mo-tip{font-size:13.5px;color:var(--mo-muted)}
  .mo-text{white-space:pre-wrap;font:500 15px/1.5 var(--font)}
  .mo-next{font-size:14px;color:var(--mo-muted)} .mo-next b{font-variant-numeric:tabular-nums;color:var(--mo-ink)}
  @media (prefers-reduced-motion:reduce){.mo-frame img{transition:none}.mo-guess.shake input{animation:none}}
</style>

<script is:inline define:vars={{ cfg }}>
(function(){
  const {T,C,CONT,schedule,launch,lang}=cfg, MAX=5;
  const BY=Object.fromEntries(C.map(c=>[c[0],c]));
  const STAGES=[{img:0,b:5,g:0},{img:1,b:3.5,g:0},{img:2,b:2,g:0},{img:3,b:0.8,g:0},{img:4,b:0,g:0}];
  const $=id=>document.getElementById('mo-'+id);
  // puzzle number from the player's local date
  const now=new Date(), today=new Date(now.getFullYear(),now.getMonth(),now.getDate());
  const [ly,lm,ld]=launch.split('-').map(Number);
  const num=Math.max(0,Math.round((today-new Date(ly,lm-1,ld))/864e5))+1;
  const answer=schedule[(num-1)%schedule.length];
  const tag='#'+String(num).padStart(3,'0');
  $('num').textContent=tag;
  const store={get(k,d){try{const v=JSON.parse(localStorage.getItem(k));return v==null?d:v;}catch(e){return d;}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}};
  let st=store.get('mordle-state',null);
  if(!st||st.num!==num) st={num,guesses:[],rider:null};
  let over=false, sel=0, list=[];
  const imgs=[0,1,2,3,4,5].map(i=>$('i'+i)), frame=$('frame'), q=$('q'), sugg=$('sugg');
  [0,1,2,3,4].forEach(i=>imgs[i].src='/mordle/'+answer+'/'+i+'.jpg');
  imgs[5].src=BY[answer][7]; imgs[5].alt=BY[answer][2];
  if(window.ResizeObserver) new ResizeObserver(()=>frame.style.setProperty('--k',frame.clientWidth/480)).observe(frame);

  function norm(s){return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[\s.\-']/g,'');}
  function matches(v){
    const n=norm(v); if(!n) return [];
    const used=new Set(st.guesses);
    return C.filter(c=>!used.has(c[0])&&(norm(c[1]).includes(n)||norm(c[2]).includes(n)))
      .sort((a,b)=>((norm(a[2]).startsWith(n)||a[1].startsWith(v))?0:1)-((norm(b[2]).startsWith(n)||b[1].startsWith(v))?0:1)).slice(0,8);
  }
  function showSugg(){
    list=matches(q.value); sel=0; sugg.textContent='';
    list.forEach((c,i)=>{const li=document.createElement('li');li.setAttribute('role','option');li.setAttribute('aria-selected',i===sel);
      const a=document.createElement('span');a.textContent=lang==='zh'?c[1]+'  '+c[2]:c[2];const b=document.createElement('small');b.textContent=c[4];
      li.append(a,b);li.addEventListener('mousedown',e=>{e.preventDefault();submit(c[0]);});sugg.appendChild(li);});
    sugg.hidden=list.length===0; q.setAttribute('aria-expanded',!sugg.hidden);
  }
  function moveSel(d){if(!list.length)return;sel=(sel+d+list.length)%list.length;[...sugg.children].forEach((li,i)=>li.setAttribute('aria-selected',i===sel));}
  q.addEventListener('input',showSugg);
  q.addEventListener('keydown',e=>{
    if(e.key==='ArrowDown'){e.preventDefault();moveSel(1);}else if(e.key==='ArrowUp'){e.preventDefault();moveSel(-1);}
    else if(e.key==='Enter'){e.preventDefault();if(list[sel])submit(list[sel][0]);else{$('guess').classList.remove('shake');void $('guess').offsetWidth;$('guess').classList.add('shake');}}
    else if(e.key==='Escape'){sugg.hidden=true;}
  });
  q.addEventListener('blur',()=>setTimeout(()=>{sugg.hidden=true;},120));

  function addRow(slug){
    const g=BY[slug],a=BY[answer]; $('rowhead').hidden=false;
    const row=document.createElement('div'); row.className='mo-row';
    const yr=g[5]===a[5]?String(g[5]):g[5]+(a[5]>g[5]?' ↑':' ↓');
    [['name',lang==='zh'?g[1]:g[2]],[g[3]===a[3]?'ok':'',CONT[g[3]]],[g[4]===a[4]?'ok':'',g[4]],[(g[5]===a[5]?'ok ':'')+'yr',yr]]
      .forEach(([cls,txt])=>{const s=document.createElement('span');s.className=cls;s.textContent=txt;s.title=txt;row.appendChild(s);});
    $('rowhead').after(row);
  }
  function score(){return st.guesses.includes(answer)?MAX-st.guesses.length+1:0;}
  function emoji(){return st.guesses.map(s=>s===answer?'🟩':'🟥').join('')+'⬜'.repeat(MAX-st.guesses.length);}
  function submit(slug){
    if(over||st.guesses.includes(slug))return;
    st.guesses.push(slug); q.value=''; sugg.hidden=true; addRow(slug);
    if(slug===answer||st.guesses.length>=MAX) finish(); else { store.set('mordle-state',st); paint(); }
  }
  async function finish(){
    over=true; store.set('mordle-state',st); paint();
    const s=store.get('mordle-stats',{played:0,wins:0,streak:0,best:0,last:0});
    if(s.last!==num){ const won=st.guesses.includes(answer); s.played++; if(won){s.wins++; s.streak=(s.last===num-1?s.streak:0)+1; s.best=Math.max(s.best,s.streak);} else s.streak=0; s.last=num; store.set('mordle-stats',s); }
    if(st.rider==null){
      try{ const r=await fetch('/api/mordle/finish',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({num})});
        if(r.ok){ const j=await r.json(); if(j && j.rider){ st.rider=j.rider; store.set('mordle-state',st);} } }catch(e){}
    }
    showCard();
  }
  function paint(){
    const won=st.guesses.includes(answer), s=STAGES[Math.min(st.guesses.length,MAX-1)];
    imgs.forEach((im,i)=>im.classList.toggle('on',over?i===5:i===s.img));
    if(!over){ imgs[s.img].style.setProperty('--b',s.b); imgs[s.img].style.setProperty('--g',s.g); }
    const boxes=$('boxes'); boxes.textContent='';
    for(let i=0;i<MAX;i++){const b=document.createElement('div');b.className='mo-box';
      if(i<st.guesses.length)b.classList.add(st.guesses[i]===answer?'hit':'miss');else if(i===st.guesses.length&&!over)b.classList.add('now');boxes.appendChild(b);}
    $('guess').hidden=over; $('end').hidden=!over;
    if(over){ const a=BY[answer];
      $('ans').textContent=(won?T.won:T.lost)+(lang==='zh'?a[1]+' '+a[2]:a[2]);
      $('intro').textContent=a[8]; $('link').href=a[6];
      $('text').textContent='Mordle '+tag+' '+score()+'/'+MAX+'\n'+emoji()+'\nmetliner.com/mordle'; }
  }
  function loadImg(src){return new Promise((r,j)=>{const i=new Image();i.onload=()=>r(i);i.onerror=j;i.src=src;});}
  async function makeCard(){
    try{await Promise.all(['800 92px Montserrat','600 28px Montserrat','800 128px Montserrat','700 42px Montserrat'].map(f=>document.fonts.load(f)));}catch(e){}
    const W=1080,H=1350,cv=document.createElement('canvas');cv.width=W;cv.height=H;const x=cv.getContext('2d');
    const F='Montserrat, sans-serif', cols=['#e0483a','#f5a623','#3aa06a','#2f7fd1','#8e44c9'];
    x.fillStyle='#0A132E';x.fillRect(0,0,W,H);
    const tiny=document.createElement('canvas');tiny.width=tiny.height=24;
    try{ tiny.getContext('2d').drawImage(await loadImg('/mordle/'+answer+'/0.jpg'),0,0,24,24);}catch(e){}
    const CW=960,CH=Math.round(CW/1.586),R=38;
    x.save();x.translate(W/2,600);x.rotate(-0.045);
    x.shadowColor='rgba(0,0,0,.45)';x.shadowBlur=60;x.shadowOffsetY=26;
    x.beginPath();x.roundRect(-CW/2,-CH/2,CW,CH,R);x.fillStyle='#10182b';x.fill();x.shadowColor='transparent';x.clip();
    x.imageSmoothingQuality='high';x.drawImage(tiny,0,3,24,16,-CW/2,-CH/2,CW,CH);
    const gr=x.createLinearGradient(0,-CH/2,0,CH/2);gr.addColorStop(0,'rgba(10,19,46,.15)');gr.addColorStop(1,'rgba(10,19,46,.75)');x.fillStyle=gr;x.fillRect(-CW/2,-CH/2,CW,CH);
    cols.forEach((c,i)=>{x.fillStyle=c;x.beginPath();x.roundRect(-CW/2+60+i*56,-CH/2+40,46,12,6);x.fill();});
    const ry=8,rx0=-CW/2+90,rx1=CW/2-90,step=(rx1-rx0)/(MAX-1);
    x.strokeStyle='rgba(255,255,255,.5)';x.lineWidth=10;x.lineCap='round';x.beginPath();x.moveTo(rx0,ry);x.lineTo(rx1,ry);x.stroke();
    for(let i=0;i<MAX;i++){const sx=rx0+i*step;x.beginPath();x.arc(sx,ry,24,0,7);
      if(i<st.guesses.length){x.fillStyle=st.guesses[i]===answer?'#3aa06a':'#e0483a';x.fill();x.lineWidth=7;x.strokeStyle='#fff';x.stroke();}
      else{x.fillStyle='#10182b';x.fill();x.lineWidth=7;x.strokeStyle='rgba(255,255,255,.6)';x.stroke();}}
    x.fillStyle='#fff';x.textBaseline='alphabetic';x.font='800 92px '+F;x.fillText('Mordle',-CW/2+56,-CH/2+140);
    x.font='600 28px '+F;x.fillStyle='rgba(255,255,255,.8)';x.fillText('by Metliner',-CW/2+60,-CH/2+182);
    x.strokeStyle='#fff';x.lineWidth=7;x.lineCap='round';
    for(let i=0;i<4;i++){x.beginPath();x.arc(CW/2-150+i*20,-CH/2+98,18+i*16,-0.75,0.75);x.stroke();}
    const ds=today.getFullYear()+'.'+String(today.getMonth()+1).padStart(2,'0')+'.'+String(today.getDate()).padStart(2,'0');
    x.fillStyle='rgba(255,255,255,.95)';x.font='700 34px '+F;
    x.fillText(st.rider?'Rider No. '+Number(st.rider).toLocaleString('en-US'):'Mordle '+tag,-CW/2+60,CH/2-92);
    x.font='600 26px '+F;x.fillStyle='rgba(255,255,255,.7)';x.fillText(st.rider?ds+'  ·  '+tag:ds,-CW/2+60,CH/2-52);
    x.textAlign='right';x.fillStyle='rgba(255,255,255,.75)';x.font='700 24px '+F;x.fillText('SCORE',CW/2-60,CH/2-170);
    x.fillStyle='#FFC816';x.font='800 128px '+F;x.fillText(score()+'/'+MAX,CW/2-56,CH/2-52);x.textAlign='left';
    x.restore();
    try{const logo=await loadImg('/img/logo.png');const lh=84,lw=lh*logo.width/logo.height;x.drawImage(logo,88,H-210,lw,lh);
      x.fillStyle='#fff';x.font='700 42px '+F;x.fillText('metliner.com/mordle',88+lw+4,H-153);}catch(e){}
    return cv;
  }
  let blob=null;
  async function showCard(){const cv=await makeCard();$('card').src=cv.toDataURL('image/png');blob=await new Promise(r=>cv.toBlob(r,'image/png'));}
  $('share').onclick=async()=>{
    if(!blob) return;
    const file=new File([blob],'mordle-'+num+'.png',{type:'image/png'});
    try{ if(navigator.canShare&&navigator.canShare({files:[file]})){await navigator.share({files:[file]});return;} }catch(e){ if(e&&e.name==='AbortError')return; }
    const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=file.name;document.body.appendChild(a);a.click();a.remove();
    $('tip').hidden=false;
  };
  $('copy').onclick=async()=>{const t=$('text').textContent;
    try{await navigator.clipboard.writeText(t);$('copy').textContent=T.copied;}
    catch(e){$('text').hidden=false;const r=document.createRange();r.selectNodeContents($('text'));const s=getSelection();s.removeAllRanges();s.addRange(r);$('copy').textContent=T.selected;}
    setTimeout(()=>$('copy').textContent=T.copy,1800);};
  function tick(){const n=new Date(),m=new Date(n.getFullYear(),n.getMonth(),n.getDate()+1),s=Math.max(0,Math.floor((m-n)/1000));
    $('count').textContent=[Math.floor(s/3600),Math.floor(s%3600/60),s%60].map(v=>String(v).padStart(2,'0')).join(':');}
  tick(); setInterval(tick,1000);
  st.guesses.forEach(addRow);
  if(st.guesses.includes(answer)||st.guesses.length>=MAX){ over=true; paint(); showCard(); } else paint();
})();
</script>
</body>
