---
// Canonical URL + language alternates for every page.
const SITE = 'https://www.metliner.com';
let path = Astro.url.pathname;
if (!path.endsWith('/')) path += '/';
const enPath = path.replace(/^\/zh\//, '/english/');
const zhPath = path.replace(/^\/english\//, '/zh/');
---
<link rel="canonical" href={SITE + path} />
<link rel="alternate" hreflang="en" href={SITE + enPath} />
<link rel="alternate" hreflang="zh-Hant" href={SITE + zhPath} />
<link rel="alternate" hreflang="x-default" href={SITE + enPath} />
