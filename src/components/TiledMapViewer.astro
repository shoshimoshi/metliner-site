---
// Zoomable map viewer.
//  - If `dzi` is given, load DZI tiles via OpenSeadragon (fast, high-res, mobile-friendly).
//  - Otherwise fall back to the single-image pan/zoom viewer (`src`).
const { dzi, src, alt, title, updated, poster } = Astro.props;
const useTiles = !!dzi;
---
<section class="viewer-section">
  <div class="viewer-inner">
    <div class="viewer-shell" data-shell>
      {useTiles ? (
        <>
          {poster && <img class="poster" src={poster} alt={alt} />}
          <div class="osd" data-osd data-dzi={dzi}></div>
        </>
      ) : (
        <div class="viewer" data-viewer>
          <img data-mapimg src={src} alt={alt} draggable="false" />
        </div>
      )}

      <div class="ctl" data-ctl>
        <button data-zin title="Zoom in" aria-label="Zoom in"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg></button>
        <button data-zout title="Zoom out" aria-label="Zoom out"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg></button>
        <div class="sep"></div>
        <button data-zreset title="Reset" aria-label="Reset view"><svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8"/><path d="M5 9.5V20h5v-6h4v6h5V9.5"/></svg></button>
        <button data-zfull title="Fullscreen" aria-label="Fullscreen"><svg viewBox="0 0 24 24"><path d="M4 9V4h5"/><path d="M20 9V4h-5"/><path d="M4 15v5h5"/><path d="M20 15v5h-5"/></svg></button>
      </div>
    </div>
  </div>
  <div class="map-caption">
    <div class="title">{title}</div>
    <div class="updated">{updated}</div>
  </div>
</section>

{useTiles && <script is:inline src="/osd/osd.min.js"></script>}

<style>
  .viewer-section{ background:var(--navy); padding:40px 0 64px; }
  .viewer-inner{ max-width:var(--viewer-max); margin:0 auto; padding:0 24px; }
  .viewer-shell{ position:relative; width:100%; height:70vh; min-height:460px;
    border-radius:var(--radius); overflow:hidden; background:#0d0d10; }

  /* OpenSeadragon canvas */
  .osd{ position:relative; width:100%; height:100%; }
  /* full map image sits under the zoomable canvas: shows while tiles load and is the image search engines index */
  .poster{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; }

  /* single-image fallback viewer */
  .viewer{ position:relative; width:100%; height:100%; overflow:hidden;
    cursor:grab; touch-action:none; }
  .viewer.grabbing{ cursor:grabbing; }
  .viewer img{ position:absolute; top:0; left:0; transform-origin:0 0;
    user-select:none; -webkit-user-drag:none; max-width:none; }

  /* modern control cluster */
  .ctl{ position:absolute; top:14px; left:14px; z-index:20;
    display:flex; flex-direction:column; gap:8px; }
  .ctl button{ width:40px; height:40px; display:flex; align-items:center; justify-content:center;
    background:rgba(20,28,54,.72); -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px);
    border:1px solid rgba(255,255,255,.14); border-radius:11px; color:#fff; cursor:pointer;
    transition:background .15s, transform .1s, border-color .15s; }
  .ctl button:hover{ background:rgba(38,50,88,.92); border-color:rgba(255,255,255,.28); }
  .ctl button:active{ transform:scale(.93); }
  .ctl button svg{ width:19px; height:19px; stroke:#fff; stroke-width:2; fill:none;
    stroke-linecap:round; stroke-linejoin:round; }
  .ctl .sep{ height:1px; background:rgba(255,255,255,.12); margin:1px 4px; }

  /* navigator: idle = faint, active = visible */
  .osd :global(.navigator){
    border:1px solid rgba(255,255,255,.18)!important; border-radius:10px!important;
    overflow:hidden!important; opacity:.18; transition:opacity .35s ease;
    box-shadow:0 6px 20px rgba(0,0,0,.4); }
  .viewer-shell.interacting .osd :global(.navigator){ opacity:1; }

  .map-caption{ max-width:var(--viewer-max); margin:22px auto 0; padding:0 24px; }
  .map-caption .title{ font-size:var(--body-size); font-weight:400; color:#fff; }
  .map-caption .updated{ font-size:var(--body-size); font-weight:400; color:#fff; }

  @media(max-width:760px){ .viewer-shell{ height:56vh; } }
</style>

<script>
  function initTiled(shell){
    const osdEl = shell.querySelector('[data-osd]');
    if(!osdEl || !window.OpenSeadragon) return false;
    const dzi = osdEl.getAttribute('data-dzi');
    const viewer = window.OpenSeadragon({
      element: osdEl,
      prefixUrl: '/osd/images/',
      tileSources: dzi,
      showNavigator: true,
      navigatorPosition: 'BOTTOM_RIGHT',
      navigatorSizeRatio: 0.15,
      navigatorAutoFade: false,
      showNavigationControl: false,
      gestureSettingsMouse: { clickToZoom:false, dblClickToZoom:true },
      gestureSettingsTouch: { pinchToZoom:true, dblClickToZoom:true },
      minZoomImageRatio: 0.8,
      maxZoomPixelRatio: 2.2,
      animationTime: 0.5,
      springStiffness: 8,
      visibilityRatio: 1,
      constrainDuringPan: true,
      backgroundColor: '#0d0d10'
    });
    const zf = 1.6;
    shell.querySelector('[data-zin]').onclick   = ()=>viewer.viewport.zoomBy(zf).applyConstraints();
    shell.querySelector('[data-zout]').onclick  = ()=>viewer.viewport.zoomBy(1/zf).applyConstraints();
    shell.querySelector('[data-zreset]').onclick= ()=>viewer.viewport.goHome();
    shell.querySelector('[data-zfull]').onclick = ()=>viewer.setFullScreen(!viewer.isFullPage());
    let idleT=null;
    const wake=()=>{ shell.classList.add('interacting'); clearTimeout(idleT);
      idleT=setTimeout(()=>shell.classList.remove('interacting'),1100); };
    viewer.addHandler('canvas-drag',wake); viewer.addHandler('zoom',wake);
    viewer.addHandler('pan',wake); viewer.addHandler('canvas-scroll',wake);
    ['mousemove','wheel','pointerdown'].forEach(ev=>osdEl.addEventListener(ev,wake,{passive:true}));
    return true;
  }

  function initSingle(shell){
    const viewer = shell.querySelector('[data-viewer]');
    if(!viewer) return;
    const img = viewer.querySelector('[data-mapimg]');
    let scale=1, minScale=1, tx=0, ty=0, natW=0, natH=0;
    function fit(){
      const vw=viewer.clientWidth, vh=viewer.clientHeight;
      natW=img.naturalWidth; natH=img.naturalHeight;
      if(!natW) return;
      minScale=Math.max(vw/natW, vh/natH); scale=minScale;
      tx=(vw-natW*scale)/2; ty=(vh-natH*scale)/2; apply();
    }
    function apply(){
      const vw=viewer.clientWidth, vh=viewer.clientHeight, w=natW*scale, h=natH*scale;
      if(w>=vw){ if(tx>0)tx=0; if(tx<vw-w)tx=vw-w; } else tx=(vw-w)/2;
      if(h>=vh){ if(ty>0)ty=0; if(ty<vh-h)ty=vh-h; } else ty=(vh-h)/2;
      img.style.transform=`translate(${tx}px,${ty}px) scale(${scale})`;
    }
    function zoomAt(cx,cy,f){
      const ns=Math.min(Math.max(scale*f,minScale),minScale*12), r=ns/scale;
      tx=cx-(cx-tx)*r; ty=cy-(cy-ty)*r; scale=ns; apply();
    }
    if(img.complete && img.naturalWidth) fit(); else img.onload=fit;
    window.addEventListener('resize',fit);
    viewer.addEventListener('wheel',(e)=>{ e.preventDefault();
      const r=viewer.getBoundingClientRect();
      zoomAt(e.clientX-r.left,e.clientY-r.top, e.deltaY<0?1.15:1/1.15); },{passive:false});
    let dragging=false,lx=0,ly=0;
    viewer.addEventListener('mousedown',(e)=>{dragging=true;lx=e.clientX;ly=e.clientY;viewer.classList.add('grabbing');});
    window.addEventListener('mouseup',()=>{dragging=false;viewer.classList.remove('grabbing');});
    window.addEventListener('mousemove',(e)=>{if(!dragging)return;tx+=e.clientX-lx;ty+=e.clientY-ly;lx=e.clientX;ly=e.clientY;apply();});
    viewer.addEventListener('dblclick',(e)=>{const r=viewer.getBoundingClientRect();zoomAt(e.clientX-r.left,e.clientY-r.top,1.8);});
    let lastDist=null,lastMid=null;
    viewer.addEventListener('touchmove',(e)=>{ e.preventDefault();
      const r=viewer.getBoundingClientRect();
      if(e.touches.length===2){
        const dx=e.touches[0].clientX-e.touches[1].clientX, dy=e.touches[0].clientY-e.touches[1].clientY;
        const d=Math.hypot(dx,dy);
        const mx=(e.touches[0].clientX+e.touches[1].clientX)/2-r.left, my=(e.touches[0].clientY+e.touches[1].clientY)/2-r.top;
        if(lastDist) zoomAt(mx,my,d/lastDist); lastDist=d;
      } else if(e.touches.length===1 && lastMid){
        tx+=e.touches[0].clientX-lastMid.x; ty+=e.touches[0].clientY-lastMid.y; apply();
        lastMid={x:e.touches[0].clientX,y:e.touches[0].clientY};
      }
      if(e.touches.length===1 && !lastMid) lastMid={x:e.touches[0].clientX,y:e.touches[0].clientY};
    },{passive:false});
    viewer.addEventListener('touchend',(e)=>{if(e.touches.length===0){lastDist=null;lastMid=null;}});
    shell.querySelector('[data-zin]').onclick=()=>zoomAt(viewer.clientWidth/2,viewer.clientHeight/2,1.4);
    shell.querySelector('[data-zout]').onclick=()=>zoomAt(viewer.clientWidth/2,viewer.clientHeight/2,1/1.4);
    shell.querySelector('[data-zreset]').onclick=fit;
    shell.querySelector('[data-zfull]').onclick=()=>{
      if(!document.fullscreenElement) shell.requestFullscreen && shell.requestFullscreen();
      else document.exitFullscreen && document.exitFullscreen();
    };
  }

  function boot(){
    document.querySelectorAll('[data-shell]').forEach((shell)=>{
      if(shell.querySelector('[data-osd]')){
        // OpenSeadragon script may still be loading; retry until ready
        if(!initTiled(shell)){
          let tries=0;
          const t=setInterval(()=>{ if(initTiled(shell) || ++tries>40) clearInterval(t); },50);
        }
      } else {
        initSingle(shell);
      }
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot);
  else boot();
</script>
